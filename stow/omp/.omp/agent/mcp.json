{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "devcontainer-mcp": {
      "command": "${HOME}/.local/bin/devcontainer-mcp",
      "args": ["serve"],
      "timeout": 1800000
    },
    "atlassian": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "timeout": 120000,
      "headers": {
        "Authorization": "!$HOME/.omp/agent/atlassian-mcp-token.py"
      }
    }
  }
}
