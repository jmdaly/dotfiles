# sway config, migrated from my old i3 config.
#
# Reference: man 5 sway, man 5 sway-input, man 5 sway-output, man 5 sway-bar
#
# Notes on the i3 -> sway differences that mattered here:
#   * Wayland-native windows have no WM_CLASS; they are matched with app_id
#     instead of class. class=... still works, but only for Xwayland windows.
#   * There is no `restart` command (sway has no in-place restart), only `reload`.
#   * A compositor is built in, so compton/picom is gone.
#   * xset/xbacklight/feh/i3lock are replaced by swayidle/brightnessctl/swaybg/swaylock.

### Output ##################################################################

# Run `swaymsg -t get_outputs` to get the real names on a given machine.
output Virtual-1 {
    mode 3840x2160@60Hz
}

# Wallpaper (was: feh --bg-fill). sway starts and manages swaybg itself and
# expands $HOME here; the trailing colour is the fallback if the image is
# missing.
output * bg $HOME/.config/wallpapers/wall.png fill #282828

### Variables ###############################################################

set $mod Mod4

# gruvbox dark
set $background  #282828
set $foreground  #ebdbb2
set $black       #282828
set $darkgrey    #928374
set $darkred     #cc241d
set $red         #fb4934
set $darkgreen   #98971a
set $green       #b8bb26
set $darkyellow  #d79921
set $yellow      #fabd2f
set $darkblue    #458588
set $blue        #83a598
set $darkmagenta #b16286
set $magenta     #d3869b
set $darkcyan    #689d6a
set $cyan        #8ec07c
set $lightgrey   #a89984
set $white       #ebdbb2
# Use custom colors for black
set $darkblack   #1d2021

set $terminal wezterm

# rofi is X11-only, so it can neither draw properly nor enumerate Wayland
# windows under sway. fuzzel is the native replacement; the two helper
# scripts below reimplement `rofi -show window` and rofi-pass on top of it.
set $menu_theme --font="Hack Nerd Font:size=11" \
    --background=282828f0 --text-color=ebdbb2ff --match-color=fabd2fff \
    --selection-color=3c3836ff --selection-match-color=fabd2fff \
    --selection-text-color=ebdbb2ff --border-color=458588ff --border-width=2
set $menu fuzzel $menu_theme
set $window_switcher $HOME/.config/sway/scripts/window-menu
set $pass_menu $HOME/.config/sway/scripts/pass-menu

# Font for window titles. Also used by swaybar and swaynag unless overridden.
# The old "System San Francisco Display" has no Nerd Font glyphs, which the
# workspace names and i3blocks labels need.
font pango:Hack Nerd Font 10

### Input ###################################################################

# input * settings live here; `swaymsg -t get_inputs` lists device identifiers.
# input type:keyboard {
#     xkb_layout us
#     repeat_delay 250
#     repeat_rate 40
